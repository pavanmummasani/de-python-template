# Copy to .env (`cp .env.example .env`) and fill in. .env is git-ignored;
# never commit real values.
# Each variable maps to a field in src/<package>/config.py (case-insensitive).

# dev or prod
APP_ENV=dev

# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Add secrets as SecretStr fields in config.py, then list them here empty:
# EXAMPLE_API_KEY=

[build-system]
requires = ["uv_build>=0.13.7,<0.14"]
build-backend = "uv_build"


[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "Data engineering project."
readme = "README.md"
license = "MIT"
license-files = ["LICENSE"]
requires-python = ">={{ python_version }}"
dependencies = [
  "pydantic-settings>=2.16",
]


[dependency-groups]
# ruff is not listed: it runs from the pre-commit hook (`uvx ruff` for ad hoc use).
dev = [
  "mypy>=2.4",
  "poethepoet>=0.49",
  "pre-commit>=4.7",
  "pytest>=9.2",
  "pytest-cov>=7.1",
  "sp-repo-review[cli]>=2026.8.14",
]


[tool.uv.build-backend]
module-name = "{{ package_name }}"


[tool.poe.tasks]
lint.help = "Pre-commit hooks on all files (mypy runs in its own task)"
lint.cmd = "pre-commit run --all-files --show-diff-on-failure"
lint.env = { SKIP = "mypy" }
types.help = "mypy strict"
types.cmd = "mypy"
test.help = "pytest with coverage, skipping integration tests"
test.cmd = "pytest --cov --cov-report=term-missing"
test-integration.help = "Only tests marked integration (need network or credentials)"
test-integration.cmd = "pytest -m integration"
review.help = "sp-repo-review against the Scientific Python guide"
review.cmd = "sp-repo-review ."
check.help = "Everything CI runs"
check.sequence = ["lint", "types", "test", "review"]


[tool.pytest]
minversion = "9.0"
# Integration tests are skipped by default; a later `-m integration` overrides this.
addopts = ["-ra", "--showlocals", "-m", "not integration"]
strict = true
filterwarnings = [
  "error",
]
log_level = "INFO"
markers = [
  "integration: needs network access or credentials; run with `uv run poe test-integration`",
]
testpaths = [
  "tests",
]


[tool.coverage]
run.source = ["{{ package_name }}"]
report.fail_under = 80
report.exclude_also = [
  '^\s*\.\.\.\s*$',
  'if typing.TYPE_CHECKING:',
]


[tool.mypy]
files = ["src", "tests"]
python_version = "{{ python_version }}"
mypy_path = "src"
strict = true
enable_error_code = ["ignore-without-code", "redundant-expr", "truthy-bool"]
warn_unreachable = true


[tool.ruff]
show-fixes = true

[tool.ruff.lint]
extend-select = [
  "ARG",    # flake8-unused-arguments
  "B",      # flake8-bugbear
  "BLE",    # flake8-blind-except
  "C4",     # flake8-comprehensions
  "DTZ",    # flake8-datetimez (timezone-aware datetimes)
  "EM",     # flake8-errmsg
  "EXE",    # flake8-executable
  "FA",     # flake8-future-annotations
  "FLY",    # flynt
  "FURB",   # refurb
  "G",      # flake8-logging-format
  "I",      # isort
  "ICN",    # flake8-import-conventions
  "ISC",    # flake8-implicit-str-concat
  "LOG",    # flake8-logging
  "NPY",    # NumPy specific rules
  "PD",     # pandas-vet
  "PERF",   # perflint
  "PGH",    # pygrep-hooks
  "PIE",    # flake8-pie
  "PL",     # pylint
  "PT",     # flake8-pytest-style
  "PTH",    # flake8-use-pathlib
  "PYI",    # flake8-pyi
  "Q",      # flake8-quotes
  "RET",    # flake8-return
  "RSE",    # flake8-raise
  "RUF",    # Ruff-specific
  "S",      # flake8-bandit (security)
  "SIM",    # flake8-simplify
  "SLOT",   # flake8-slots
  "T10",    # flake8-debugger
  "T20",    # flake8-print
  "TC",     # flake8-type-checking
  "TRY",    # tryceratops
  "UP",     # pyupgrade
  "YTT",    # flake8-2020
]
ignore = [
  "PLR09",    # Too many <...>
  "PLR2004",  # Magic value used in comparison
]

[tool.ruff.lint.flake8-type-checking]
# pydantic reads annotations at runtime; keep their imports out of TYPE_CHECKING.
runtime-evaluated-base-classes = ["pydantic.BaseModel", "pydantic_settings.BaseSettings"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "T20"]


[tool.pymarkdown]
# Long lines are normal in tables and links; ruff-format and review handle prose width.
plugins.md013.enabled = false


[tool.repo-review]
# PC140: mypy runs as a local hook from the locked env; the check only
#        recognises mirrors-mypy, whose separate deps drift from uv.lock.
# PC170: rST lint hooks; this project has no .rst files.
# PC180: prettier needs Node.js; ruff-format formats markdown code blocks.
# PC901-PC903: pre-commit.ci settings; hooks run in this repo's own CI.
ignore = ["PC140", "PC170", "PC180", "PC901", "PC902", "PC903"]
